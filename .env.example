# Copy to .env and fill in. .env is git-ignored — never commit a real key.

# Required. Get one from TypeSafe.
TYPESAFE_API_KEY=your-key-here

# Optional TypeSafe SDK settings.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional MCP bridge settings (mcp/jev).
# JEV_MCP_TIMEOUT_MS=10000
# JEV_MCP_LOG_LEVEL=warn

# Setting JEV_MCP_LOG_LEVEL=debug would make the TypeSafe SDK log raw request
# bodies — your state and answers — without redaction. The bridge refuses debug
# unless you also set this to 1. Do not enable it against production data.
# JEV_MCP_ALLOW_BODY_LOGGING=1
